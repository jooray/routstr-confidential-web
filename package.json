{
  "name": "@routstr/confidential-web",
  "version": "0.1.1",
  "description": "Routstr confidential mode (protocol v2) in the browser: the node never sees the prompt or the response, the client never sees the provider key; 2PC handshake and proofs in wasm",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/jooray/routstr-confidential-web.git" },
  "homepage": "https://github.com/jooray/routstr-confidential-web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./worker": { "import": "./dist/wasm/worker.js" },
    "./wasm/client_wasm_bg.wasm": "./wasm/pkg/client_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": ["dist", "wasm/pkg", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build:wasm": "./scripts/build-wasm.sh",
    "build": "node scripts/build-lib.mjs",
    "prepare": "node scripts/build-lib.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "harness:build": "vite build --config harness/vite.config.ts",
    "bench:browser": "node scripts/browser-bench.mjs",
    "tls-check": "node scripts/tls-check.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@peculiar/asn1-ecc": "2.10.0",
    "@peculiar/asn1-rsa": "2.10.0",
    "@peculiar/asn1-schema": "2.10.0",
    "@peculiar/asn1-x509": "2.10.0",
    "@peculiar/x509": "1.14.3",
    "micro-rsa-dsa-dh": "0.1.0"
  },
  "devDependencies": {
    "binaryen": "123.0.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.1.9",
    "ws": "8.18.3"
  }
}
