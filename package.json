{
  "name": "routstr-confidential-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/confidential-web",
    "apps/demo-pwa"
  ],
  "scripts": {
    "build:wasm": "./scripts/build-wasm.sh",
    "build": "npm run build:wasm && npm run -w @routstr/confidential-web typecheck && npm run -w demo-pwa build",
    "test": "npm run -w @routstr/confidential-web test",
    "test:browser": "node scripts/browser-bench.mjs",
    "dev": "npm run -w demo-pwa dev"
  },
  "devDependencies": {
    "binaryen": "123.0.0",
    "playwright": "1.56.1"
  }
}
