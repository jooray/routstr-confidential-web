+        std::thread::scope(|sc| {
+            let hs: Vec<_> = (0..n).map(|s| sc.spawn(move || f(s))).collect();
+            body();
+            hs.into_iter().map(|h| h.join().expect("rows thread")).collect()
+        })
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        body();
+        (0..n).map(f).collect()
+    }
+}
