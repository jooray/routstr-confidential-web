+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::thread::scope(|sc| {
+            let r0 = sc.spawn(|| f(0));
+            let r1 = sc.spawn(|| f(1));
+            body();
+            [r0.join().expect("rows thread"), r1.join().expect("rows thread")]
+        })
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        body();
+        [f(0), f(1)]
+    }
+}
